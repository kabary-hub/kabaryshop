# ============================================================================
# Kabary Shop — Variables d'environnement
#
# ⚠️ IMPORTANT : ces variables NE DOIVENT PAS contenir de secrets côté
#    navigateur. La clé API Resend est SECRÈTE : elle se configure UNIQUEMENT
#    sur Vercel (variables d'environnement du projet), jamais dans un fichier
#    .env local commité, ni dans le code.
#
# Les deux variables préfixées VITE_* sont lues par le site (navigateur) et
# ne contiennent que des informations publiques.
# ============================================================================

# ----------------------------------------------------------------------------
# CÔTÉ VERCEL (tableau de bord Vercel → Project → Settings → Environment
# Variables) — ces variables sont lues par la fonction api/send-mail.js
# ----------------------------------------------------------------------------

# Clé API Resend (obligatoire). Créez-la sur resend.com/api-keys.
# Le plan gratuit offre 3 000 emails/mois.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Adresse d'expéditeur (obligatoire pour envoyer vers des boîtes externes).
# Après avoir vérifié votre domaine sur resend.com/domains, utilisez par ex. :
#   EMAIL_FROM=contact@votre-domaine.com
# Sans domaine vérifié, laissez la valeur par défaut ci-dessous (limité à
# l'adresse de test, emails reçus uniquement par vous) :
# EMAIL_FROM=onboarding@resend.dev

# Adresse de réponse (optionnelle, ex. votre email support) :
# EMAIL_REPLY_TO=support@votre-domaine.com

# Clé partagée optionnelle (anti-abus). Si vous la définissez ici, le site
# doit l'envoyer : copiez la même valeur dans VITE_SEND_KEY côté build.
# SEND_API_KEY=mon-mot-de-passe-partage

# ----------------------------------------------------------------------------
# CÔTÉ SITE (fichier .env à la racine, lu au build par Vite) — ces variables
# sont publiques et incluses dans le bundle JavaScript
# ----------------------------------------------------------------------------

# URL de la fonction d'envoi. Par défaut /api/send-mail (déployé avec le
# projet sur Vercel).
#
# En développement local, ne changez RIEN : le proxy Vite redirige déjà
# /api/* vers le serveur de dev email (node scripts/dev-mail-server.mjs,
# port 3010) qui simule la fonction Vercel. Voir GUIDE_RESEND_VERCEL.md.
# VITE_EMAIL_API_URL=/api/send-mail

# Clé partagée correspondant à SEND_API_KEY (si configurée côté Vercel) :
# VITE_SEND_KEY=mon-mot-de-passe-partage

# ----------------------------------------------------------------------------
# SYNCHRONISATION MULTI-APPAREILS (SUPABASE) — OPTIONNEL MAIS RECOMMANDÉ
# ----------------------------------------------------------------------------
# Sans ces deux variables, le site fonctionne en local uniquement (chaque
# navigateur a ses propres données). Avec elles, toutes les données
# (commandes, utilisateurs, produits, paramètres…) sont synchronisées en
# temps réel entre tous les ordinateurs.
#
# Créer un projet gratuit sur https://supabase.com (sans carte bancaire),
# exécuter le script supabase/migrations/0001_init_sync_store.sql dans
# l'éditeur SQL, puis copier ici :
#   • Project Settings → API → Project URL
#   • Project Settings → API → anon public key
#
# ⚠️ Ces variables sont publiques (incluses dans le bundle JavaScript).
#    La clé « anon » de Supabase est faite pour ça : elle est protégée par
#    les politiques RLS de la table sync_store (voir le script SQL).
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
